{
  "opencollection": "1.0.0",
  "info": {
    "name": "LOVO AI Genny Speakers API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-KEY",
      "value": "{{X-API-KEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Speakers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve speakers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.genny.lovo.ai/api/v1/speakers",
            "params": [
              {
                "name": "sort",
                "value": "",
                "type": "query",
                "description": "Sort by given order. Available fields are displayName, locale, gender, speakerType, and ageRange. Example \"displayName:1\" (no whitespace)."
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Number of pages to skip."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of speakers in each page."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-KEY",
              "value": "{{X-API-KEY}}",
              "placement": "header"
            }
          },
          "docs": "Retrieve all speakers with optional filtering and sorting. Supports pagination."
        }
      ]
    }
  ],
  "bundled": true
}